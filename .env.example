# ---------- LLM Configuration ----------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ---------- Wallet Configuration ----------
WALLET_PRIVATE_KEY=0x...
WALLET_ADDRESS=0x...

# ---------- Trading Configuration ----------
EXCHANGE=binance
EXCHANGE_API_KEY=...
EXCHANGE_API_SECRET=...
MAX_TRADE_AMOUNT=100
MIN_PROFIT_PERCENT=0.5

# ---------- Physical World Configuration ----------
PRINTER_API_KEY=...
PRINTER_ENDPOINT=http://localhost:5000
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=...
DEPIN_API_KEY=...
DEPIN_NETWORK=helium
DRONE_API_KEY=...
DRONE_ENDPOINT=http://localhost:8080

# ---------- NOESIS Configuration ----------
PLANNING_INTERVAL_DAYS=30
MAX_GOALS_PER_PLAN=5
STRATEGY_HORIZON_YEARS=5
SCIENTIFIC_MODE=true
MAX_HYPOTHESES_PER_CYCLE=3
PATENT_MODE=true
PATENT_DB_PATH=./data/patents.db

# ---------- Replication & Survival ----------
MAX_CHILDREN=10
MIN_BALANCE_FOR_REPLICATION=50
CHILD_INITIAL_FUNDING=10
CHILD_DEATH_BALANCE=0
CONSTITUTION_VERSION=1.0.0
SURVIVAL_CHECK_INTERVAL=300
SOUL_BACKUP_PATH=./data/soul_backup.json
SOUL_BACKUP_INTERVAL=3600

# ---------- Phase 6: Memory & Skills ----------
# Three-layer memory
WORKING_MEMORY_SIZE=20
EPISODIC_MEMORY_SIZE=100
PROCEDURAL_MEMORY_SIZE=50

# Skill evolution
AUTO_SKILL_EXTRACTION=true
MAX_SKILLS_PER_CYCLE=3

# ---------- Phase 6: Platforms ----------
# Discord
DISCORD_BOT_TOKEN=...
DISCORD_GUILD_ID=...

# Telegram
TELEGRAM_BOT_TOKEN=...

# Slack
SLACK_BOT_TOKEN=...
SLACK_SIGNING_SECRET=...

# Browser
BROWSER_MAX_TABS=5
BROWSER_HEADLESS=true
