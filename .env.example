# ============================================================
# LLM PROVIDER SELECTION
# ============================================================

# Choose ONE: openai | anthropic | nim | huggingface | together | groq | replicate | mistral | cohere | deepseek | perplexity | openrouter | ollama | lmstudio | localai | vllm | tgi | generic
LLM_PROVIDER=openai

# ============================================================
# SHARED SETTINGS (Used as fallback for all providers)
# ============================================================

LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ============================================================
# PROVIDER-SPECIFIC SETTINGS
# ============================================================

# ---- OPENAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- ANTHROPIC ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- NVIDIA NIM ----
NIM_API_KEY=your_nim_key
NIM_MODEL=meta/llama3-70b-instruct
NIM_BASE_URL=http://localhost:8000/v1

# ---- HUGGING FACE ----
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_MODEL=meta-llama/Llama-3-70B-Instruct
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models

# ---- TOGETHER AI ----
TOGETHER_API_KEY=...
TOGETHER_MODEL=meta-llama/Llama-3-70B-Instruct-Turbo
TOGETHER_BASE_URL=https://api.together.xyz/v1

# ---- GROQ ----
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-70b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- REPLICATE ----
REPLICATE_API_KEY=r8_...
REPLICATE_MODEL=meta/meta-llama-3-70b-instruct
REPLICATE_BASE_URL=https://api.replicate.com/v1

# ---- MISTRAL ----
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ---- COHERE ----
COHERE_API_KEY=...
COHERE_MODEL=command-r-plus
COHERE_BASE_URL=https://api.cohere.ai/v1

# ---- DEEPSEEK ----
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- PERPLEXITY ----
PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_MODEL=llama-3.1-70b-instruct
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# ---- OPENROUTER ----
OPENROUTER_API_KEY=sk-...
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=http://localhost:3000

# ---- LOCAL MODELS (NO API KEY NEEDED) ----

# Ollama
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio
LMSTUDIO_MODEL=local-model
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# LocalAI
LOCALAI_MODEL=llama3
LOCALAI_BASE_URL=http://localhost:8080/v1

# vLLM
VLLM_MODEL=meta-llama/Llama-3-70B-Instruct
VLLM_BASE_URL=http://localhost:8000/v1

# TGI (Text Generation Inference)
TGI_MODEL=meta-llama/Llama-3-70B-Instruct
TGI_BASE_URL=http://localhost:8080

# ---- GENERIC/CUSTOM ----
GENERIC_API_KEY=...
GENERIC_MODEL=default
GENERIC_BASE_URL=http://localhost:8080/v1
