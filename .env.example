# ============================================================
# EKO 1.2.0 — Complete Environment Configuration
# ============================================================

# ============================================================
# LLM PROVIDER SELECTION
# ============================================================

# Choose ONE provider below.
# Options: openai | anthropic | nim | huggingface | together | groq | replicate | mistral | cohere | deepseek | perplexity | openrouter | ollama | lmstudio | localai | vllm | tgi | generic

# ---- DEFAULT (Uncomment one and fill in the keys) ----

# OPTION 1: OpenAI (PAID - Best quality)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OPTION 2: Groq (FREE - Fastest inference)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
# GROQ_MODEL=llama3-70b-8192
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OPTION 3: Ollama (FREE - Local, no API key needed)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# OPTION 4: Hugging Face (FREE - Limited rate)
# LLM_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=hf_YOUR_HF_KEY_HERE
# HUGGINGFACE_MODEL=meta-llama/Llama-3-70B-Instruct
# HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models

# OPTION 5: Together AI ($5 FREE credit)
# LLM_PROVIDER=together
# TOGETHER_API_KEY=YOUR_TOGETHER_KEY_HERE
# TOGETHER_MODEL=meta-llama/Llama-3-70B-Instruct-Turbo
# TOGETHER_BASE_URL=https://api.together.xyz/v1

# OPTION 6: Anthropic Claude (PAID)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OPTION 7: NVIDIA NIM (FREE self-hosted or cloud)
# LLM_PROVIDER=nim
# NIM_API_KEY=your_nim_key
# NIM_MODEL=meta/llama3-70b-instruct
# NIM_BASE_URL=http://localhost:8000/v1

# OPTION 8: OpenRouter (Multiple models, pay-per-use)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-YOUR_OPENROUTER_KEY_HERE
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=http://localhost:3000

# OPTION 9: LM Studio (FREE - Local)
# LLM_PROVIDER=lmstudio
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# OPTION 10: vLLM (FREE - Local)
# LLM_PROVIDER=vllm
# VLLM_MODEL=meta-llama/Llama-3-70B-Instruct
# VLLM_BASE_URL=http://localhost:8000/v1

# OPTION 11: Generic/Custom Endpoint
# LLM_PROVIDER=generic
# GENERIC_API_KEY=your_key_if_needed
# GENERIC_MODEL=default
# GENERIC_BASE_URL=http://localhost:8080/v1

# ============================================================
# CRYPTO WALLET (Optional - For real trading)
# ============================================================

# WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# ============================================================
# EXCHANGE API (Optional - For real trading)
# ============================================================

# EXCHANGE=binance
# EXCHANGE_API_KEY=your_api_key
# EXCHANGE_API_SECRET=your_api_secret
# MAX_TRADE_AMOUNT=100
# MIN_PROFIT_PERCENT=0.5

# ============================================================
# PHYSICAL WORLD (Optional - For real devices)
# ============================================================

# 3D Printer
# PRINTER_API_KEY=your_printer_key
# PRINTER_ENDPOINT=http://localhost:5000

# Smart Home (Home Assistant)
# HOME_ASSISTANT_URL=http://localhost:8123
# HOME_ASSISTANT_TOKEN=your_ha_token

# DePIN (Helium, Spheron)
# DEPIN_API_KEY=your_depin_key
# DEPIN_NETWORK=helium

# Drone
# DRONE_API_KEY=your_drone_key
# DRONE_ENDPOINT=http://localhost:8080

# ============================================================
# PLATFORMS (Optional - For messaging)
# ============================================================

# Discord
# DISCORD_BOT_TOKEN=your_discord_token
# DISCORD_GUILD_ID=your_guild_id

# Telegram
# TELEGRAM_BOT_TOKEN=your_telegram_token

# Slack
# SLACK_BOT_TOKEN=your_slack_token
# SLACK_SIGNING_SECRET=your_slack_secret

# ============================================================
# NOESIS Configuration
# ============================================================

# PLANNING_INTERVAL_DAYS=30
# MAX_GOALS_PER_PLAN=5
# STRATEGY_HORIZON_YEARS=5
# SCIENTIFIC_MODE=true
# MAX_HYPOTHESES_PER_CYCLE=3
# PATENT_MODE=true
# PATENT_DB_PATH=./data/patents.db

# ============================================================
# REPLICATION & SURVIVAL
# ============================================================

# MAX_CHILDREN=10
# MIN_BALANCE_FOR_REPLICATION=50
# CHILD_INITIAL_FUNDING=10
# CHILD_DEATH_BALANCE=0
# CONSTITUTION_VERSION=1.0.0
# SURVIVAL_CHECK_INTERVAL=300
# SOUL_BACKUP_PATH=./data/soul_backup.json
# SOUL_BACKUP_INTERVAL=3600

# ============================================================
# MEMORY & SKILLS (Phase 6)
# ============================================================

# WORKING_MEMORY_SIZE=20
# EPISODIC_MEMORY_SIZE=100
# PROCEDURAL_MEMORY_SIZE=50
# AUTO_SKILL_EXTRACTION=true
# MAX_SKILLS_PER_CYCLE=3

# ============================================================
# PHASE 7: KNOWLEDGE LOOP
# ============================================================

KNOWLEDGE_LOOP=true
AUTO_SKILL_EXTRACTION=true

# MCP Server (optional)
# MCP_SERVER_URL=http://localhost:8000

# ============================================================
# API SERVER
# ============================================================

PORT=3000

# ============================================================
# BROWSER (Phase 6)
# ============================================================

# BROWSER_MAX_TABS=5
# BROWSER_HEADLESS=true

# ============================================================
# LOGGING
# ============================================================

# LOG_LEVEL=info
# LOG_FILE=./logs/eko.log

# ============================================================
# BLOCKCHAIN & WALLET
# ============================================================

# Ethereum RPC URL (default: llama RPC)
RPC_URL=https://eth.llamarpc.com

# Your wallet private key (starts with 0x)
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# ============================================================
# EXCHANGE API (Binance, Coinbase, Kraken)
# ============================================================

EXCHANGE=binance
EXCHANGE_API_KEY=your_api_key
EXCHANGE_API_SECRET=your_api_secret
