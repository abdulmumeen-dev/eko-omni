# ---------- LLM Configuration ----------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ---------- Wallet Configuration ----------
WALLET_PRIVATE_KEY=0x...
WALLET_ADDRESS=0x...

# ---------- Trading Configuration ----------
EXCHANGE=binance
EXCHANGE_API_KEY=...
EXCHANGE_API_SECRET=...
MAX_TRADE_AMOUNT=100
MIN_PROFIT_PERCENT=0.5

# ---------- Physical World Configuration ----------
PRINTER_API_KEY=...
PRINTER_ENDPOINT=http://localhost:5000
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=...
DEPIN_API_KEY=...
DEPIN_NETWORK=helium
DRONE_API_KEY=...
DRONE_ENDPOINT=http://localhost:8080

# ---------- NOESIS Configuration ----------
# Long-term planning
PLANNING_INTERVAL_DAYS=30
MAX_GOALS_PER_PLAN=5
STRATEGY_HORIZON_YEARS=5

# Scientific discovery
SCIENTIFIC_MODE=true
MAX_HYPOTHESES_PER_CYCLE=3

# Patent generation
PATENT_MODE=true
PATENT_DB_PATH=./data/patents.db
